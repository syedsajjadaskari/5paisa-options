# ==============================================================================
# Environment Configuration - 5paisa Options & Multi-Strategy Research Platform
# ==============================================================================
# IMPORTANT:
# - Copy this file to `.env` and fill in your actual credentials.
# - NEVER commit `.env` or any real credentials/tokens into version control.
# - Default execution mode is strictly PAPER. LIVE trading requires explicit enablement.
# ==============================================================================

# Application Environment (DEVELOPMENT, RESEARCH, PAPER, LIVE)
PLATFORM_ENV=RESEARCH
LOG_LEVEL=INFO

# Broker Selection & Operational Mode
BROKER_TYPE=fivepaisa
OPERATIONAL_MODE=PAPER  # Options: PAPER, RESEARCH, LIVE (Disabled by default)

# 5paisa Broker Credentials (Required ONLY for 5paisa live/data connectivity)
FIVEPAISA_APP_NAME=YOUR_APP_NAME
FIVEPAISA_APP_SOURCE=YOUR_APP_SOURCE
FIVEPAISA_USER_ID=YOUR_CLIENT_CODE
FIVEPAISA_PASSWORD=YOUR_CLIENT_PASSWORD
FIVEPAISA_USER_KEY=YOUR_USER_KEY
FIVEPAISA_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY
FIVEPAISA_TOTP_SECRET=YOUR_TOTP_KEY

# Data Storage Paths
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REFERENCE_DIR=data/reference
DATA_CACHE_DIR=data/cache
DUCKDB_DATABASE_PATH=data/processed/market_data.duckdb

# Risk Safeguards (Central Safety Limits)
MAX_DAILY_LOSS_INR=15000.0
MAX_RISK_PER_TRADE_INR=3000.0
MAX_OPEN_POSITIONS=2
EMERGENCY_KILL_SWITCH=false
