# ==============================================================================
# Environment Configuration - 5paisa Options & Multi-Strategy Research Platform
# ==============================================================================
# IMPORTANT:
# - Copy this file to `.env` and fill in your actual credentials.
# - NEVER commit `.env` or any real credentials/tokens into version control.
# - The paper-trading app (scripts/run_paper_trading.py) reads ONLY the FIVEPAISA_* credential
#   lines below. It places no real orders; there is no LIVE trading mode and NO kill switch.
#   Its limits live in configs/live_paper.yaml. Stop it with Ctrl+C / kill -TERM.
# - Lines marked "legacy - NOT read by the paper app" are inert there; they only matter to
#   the older research/ConfigManager code and do not control the paper app in any way.
# ==============================================================================

# Application Environment (DEVELOPMENT, RESEARCH, PAPER, LIVE)  # legacy - NOT read by the paper app
PLATFORM_ENV=RESEARCH
LOG_LEVEL=INFO  # legacy - NOT read by the paper app

# Broker Selection & Operational Mode
BROKER_TYPE=fivepaisa  # legacy - NOT read by the paper app
# legacy - NOT read by the paper app (there is no live-order mode in the paper app)
OPERATIONAL_MODE=PAPER  # Options: PAPER, RESEARCH, LIVE (Disabled by default)

# 5paisa Broker Credentials (Required ONLY for 5paisa live/data connectivity)
FIVEPAISA_APP_NAME=YOUR_APP_NAME
FIVEPAISA_APP_SOURCE=YOUR_APP_SOURCE
FIVEPAISA_USER_ID=YOUR_CLIENT_CODE
FIVEPAISA_PASSWORD=YOUR_CLIENT_PASSWORD
FIVEPAISA_USER_KEY=YOUR_USER_KEY
FIVEPAISA_ENCRYPTION_KEY=YOUR_ENCRYPTION_KEY
FIVEPAISA_TOTP_SECRET=YOUR_TOTP_KEY
# Required for TOTP login (names only; fill in your own .env, never commit values):
FIVEPAISA_PIN=
# Optional: trading client code if it differs from FIVEPAISA_USER_ID
FIVEPAISA_CLIENT_CODE=

# Data Storage Paths  # legacy - NOT read by the paper app (it uses configs/live_paper.yaml paths)
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_REFERENCE_DIR=data/reference
DATA_CACHE_DIR=data/cache
DUCKDB_DATABASE_PATH=data/processed/market_data.duckdb  # legacy research only; the paper app has no database

# Risk Safeguards (Central Safety Limits)
# legacy - NOT read by the paper app. The paper app's real limits are in configs/live_paper.yaml
# (max_daily_loss_pct: 10 of session-opening equity, max_open_positions: 1) and these values
# DO NOT match them. EMERGENCY_KILL_SWITCH does nothing: there is no kill switch (Ctrl+C stops).
MAX_DAILY_LOSS_INR=15000.0
MAX_RISK_PER_TRADE_INR=3000.0
MAX_OPEN_POSITIONS=2
EMERGENCY_KILL_SWITCH=false
